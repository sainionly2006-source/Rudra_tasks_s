{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RudraEdge Synthetic Sensor Message",
  "type": "object",
  "required": [
    "timestamp",
    "sensor_id",
    "value",
    "unit",
    "status"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 date/time"
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "error"
      ]
    }
  },
  "additionalProperties": false
}
